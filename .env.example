# ─────────────────────────────────────────────────────────────
# Razorpay
# ─────────────────────────────────────────────────────────────
# The secret you set when creating the webhook in the Razorpay Dashboard.
# Used to verify the X-Razorpay-Signature header on every request.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─────────────────────────────────────────────────────────────
# Gmail SMTP (nodemailer)
# ─────────────────────────────────────────────────────────────
# Your full Gmail address.
GMAIL_USER=you@gmail.com
# A 16-character Google App Password (NOT your normal Gmail password).
# See the README for how to generate one.
GMAIL_APP_PASSWORD=your_16_char_app_password

# ─────────────────────────────────────────────────────────────
# WhatsApp (Interakt)
# ─────────────────────────────────────────────────────────────
# Interakt API key (Dashboard → Settings → Developer Settings → API Key).
WHATSAPP_API_KEY=your_interakt_api_key
# The exact name of your APPROVED WhatsApp template.
WHATSAPP_TEMPLATE_NAME=payment_confirmation
# Optional: template language code (defaults to "en").
WHATSAPP_TEMPLATE_LANG=en
# Optional: default country code when a phone number arrives without one.
WHATSAPP_DEFAULT_COUNTRY_CODE=+91

# ─────────────────────────────────────────────────────────────
# Branding (optional)
# ─────────────────────────────────────────────────────────────
# Shown in the email body and "from" name.
EVENT_NAME=My Event
MAIL_FROM_NAME=Event Team

# ─────────────────────────────────────────────────────────────
# Server (optional — ignored on Vercel)
# ─────────────────────────────────────────────────────────────
PORT=3000
