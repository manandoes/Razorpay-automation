# ─────────────────────────────────────────────────────────────
# Razorpay
# ─────────────────────────────────────────────────────────────
# The secret you set when creating the webhook in the Razorpay Dashboard.
# Used to verify the X-Razorpay-Signature header on every request.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─────────────────────────────────────────────────────────────
# Brevo SMTP (transactional email)
# ─────────────────────────────────────────────────────────────
# From Brevo dashboard → SMTP & API → SMTP tab
BREVO_SMTP_USER=your_brevo_login_email
BREVO_SMTP_PASSWORD=your_brevo_smtp_password
# The verified sender address (your Gmail verified in Brevo)
BREVO_FROM_EMAIL=you@gmail.com

# ─────────────────────────────────────────────────────────────
# WhatsApp (self-hosted bot)
# ─────────────────────────────────────────────────────────────
# Your bot's send endpoint. Receives { phone_number, message_text }.
WHATSAPP_BOT_URL=http://34.28.139.132/send
# Optional: default country code when a phone number arrives without one.
WHATSAPP_DEFAULT_COUNTRY_CODE=+91

# ─────────────────────────────────────────────────────────────
# Branding (optional)
# ─────────────────────────────────────────────────────────────
# Shown in the email body and "from" name.
EVENT_NAME=My Event
MAIL_FROM_NAME=Event Team

# ─────────────────────────────────────────────────────────────
# Server (optional — ignored on Vercel)
# ─────────────────────────────────────────────────────────────
PORT=3000
